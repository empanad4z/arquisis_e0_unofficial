# Copy this file to ".env" and adjust if needed.
#
# This is the file "docker compose up" reads by default (Docker Compose
# auto-loads ".env" from the project root for ${VAR} interpolation).
#
# Postgres runs as its own container (service "postgres" in
# docker-compose.yaml) — there's no AWS RDS anymore, and no separate
# local/production split. The same docker-compose.yaml (and the same .env
# shape) is used for local development and for the EC2 deploy; "master"
# builds its DATABASE_URL from these variables inside docker-compose.yaml.
#
# ".env" itself is git-ignored. These aren't secrets in the traditional
# sense — Postgres is never exposed outside the host (see the "127.0.0.1"
# port binding in docker-compose.yaml) — but real per-deployment values are
# kept out of git regardless, so you can change them per environment without
# touching a tracked file.

POSTGRES_USER=master
POSTGRES_PASSWORD=master
POSTGRES_DB=master
