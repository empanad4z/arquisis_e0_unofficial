# Copy this file to ".env" and fill in the real values.
#
# This is the file "docker compose up" reads by default (Docker Compose
# auto-loads ".env" from the project root for ${VAR} interpolation).
# It is meant for the "production" target: the AWS RDS Postgres instance.
#
# ".env" itself is git-ignored on purpose — never commit real credentials.

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<aws-rds-endpoint>:5432/<database>
