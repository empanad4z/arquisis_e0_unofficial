# Local development credentials — NOT secrets, safe to commit.
#
# Used by "make local" via:
#   docker compose --env-file .env.local up
#
# Assumes Postgres is installed and running natively on your machine (NOT
# in a container) — e.g. `sudo apt install postgresql` / `brew install
# postgresql` — with a role/database matching these credentials:
#
#   sudo -u postgres createuser -P master     # password: master
#   sudo -u postgres createdb -O master master
#
# "master" and "connector" still run in Docker (make local), so from inside
# the container the DB is reached via "host.docker.internal" (mapped to the
# host's gateway in docker-compose.yaml) instead of "localhost" — otherwise
# this is the exact same DATABASE_URL mechanism used to reach the AWS RDS
# instance in ".env": swap the host/user/password/db and nothing else
# changes.

POSTGRES_USER=master
POSTGRES_PASSWORD=master
POSTGRES_DB=master

DATABASE_URL=postgresql+asyncpg://master:master@host.docker.internal:5432/master
