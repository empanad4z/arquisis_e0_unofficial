# Local development credentials — NOT secrets, safe to commit.
#
# Used by "make local" via:
#   docker compose -f docker-compose.yaml -f docker-compose.local.yaml --env-file .env.local up
#
# This spins up its own throwaway Postgres container (service "postgres" in
# docker-compose.local.yaml) instead of touching the AWS database.

POSTGRES_USER=master
POSTGRES_PASSWORD=master
POSTGRES_DB=master

# "postgres" below is the service name in docker-compose.local.yaml, resolved
# via the internal Docker network — not localhost.
DATABASE_URL=postgresql+asyncpg://master:master@postgres:5432/master
